#include <stdio.h>

void torre(int passo, int limite) {
    if (passo > limite) return;
    printf("Movimento da Torre:\n");
    printf("Direita\n");
    torre(passo + 1, limite);
}

void bispo(int passo, int limite) {
    if (passo > limite) return;
    printf("Movimento do Bispo:\n");
    for (int i = 1; i <= 1; i++) {
        for (int j = 1; j <= 1; j++) {
            printf("Cima, Direita\n");
        }
    }
    bispo(passo + 1, limite);
}

void rainha(int passo, int limite) {
    if (passo > limite) return;
    printf("Movimento da Rainha:\n");
    printf("Esquerda\n");
    rainha(passo + 1, limite);
}

void cavalo() {
    printf("\n");
    printf("Movimento do Cavalo:\n");

    int i, j;
    for (i = 2, j = 1; (i >= 0 && j <= 1); i--, j++) {
        if (i > 0) {
            printf("Cima\n");
            continue;
        }
        if (i == 0) {
            printf("Direita\n");
            break;
        }
    }
}

int main() {
    torre(1, 5);
    bispo(1, 5);
    rainha(1, 8);
    cavalo();
    return 0;
}
